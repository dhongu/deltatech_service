<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        Land and building delegate to maintenance.equipment (_inherits): the equipment rules
        (multi-company, followers for users, everything for equipment managers) already apply
        to them. Rooms, features and building history are independent models, so they get
        the same rules through their building.
    -->
    <record id="property_room_company_rule" model="ir.rule">
        <field name="name">Property Room multi-company</field>
        <field name="model_id" ref="model_property_room" />
        <field name="domain_force">[('building_id.company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="property_room_user_rule" model="ir.rule">
        <field name="name">Property Room: users access the buildings they follow</field>
        <field name="model_id" ref="model_property_room" />
        <field name="domain_force">[('building_id.base_equipment_id.message_partner_ids', 'in', [user.partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>
    <record id="property_room_manager_rule" model="ir.rule">
        <field name="name">Property Room: equipment managers access all buildings</field>
        <field name="model_id" ref="model_property_room" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('maintenance.group_equipment_manager'))]" />
    </record>
    <record id="property_features_company_rule" model="ir.rule">
        <field name="name">Property Features multi-company</field>
        <field name="model_id" ref="model_property_features" />
        <field name="domain_force">[('building_id.company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="property_features_user_rule" model="ir.rule">
        <field name="name">Property Features: users access the buildings they follow</field>
        <field name="model_id" ref="model_property_features" />
        <field name="domain_force">[('building_id.base_equipment_id.message_partner_ids', 'in', [user.partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>
    <record id="property_features_manager_rule" model="ir.rule">
        <field name="name">Property Features: equipment managers access all buildings</field>
        <field name="model_id" ref="model_property_features" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('maintenance.group_equipment_manager'))]" />
    </record>
    <record id="building_history_company_rule" model="ir.rule">
        <field name="name">Building History multi-company</field>
        <field name="model_id" ref="model_building_history" />
        <field name="domain_force">[('building_id.company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="building_history_user_rule" model="ir.rule">
        <field name="name">Building History: users access the buildings they follow</field>
        <field name="model_id" ref="model_building_history" />
        <field name="domain_force">[('building_id.base_equipment_id.message_partner_ids', 'in', [user.partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>
    <record id="building_history_manager_rule" model="ir.rule">
        <field name="name">Building History: equipment managers access all buildings</field>
        <field name="model_id" ref="model_building_history" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('maintenance.group_equipment_manager'))]" />
    </record>
</odoo>
